{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "jsx": "preserve",
    "skipLibCheck": false,
    "allowJs": false,
    "types": ["node", "vite/client"]
  },
  "include": ["src", "vite.config.ts"]
}
